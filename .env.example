# Model provider - optional for initial local development
MODEL_PROVIDER=local
MODEL_NAME=mock-deep-agent

# LangSmith / Managed Deep Agents - optional
LANGSMITH_API_KEY=

# Algorand TestNet Configuration
ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=
INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
INDEXER_PORT=443
INDEXER_TOKEN=

# TestNet Accounts (Private keys & mnemonics must NEVER be committed)
AGENT_MNEMONIC=
VERIFIER_MNEMONIC=
CONTRACT_CREATOR_MNEMONIC=

# SentinelPay Contract & Keys
SENTINELPAY_APP_ID=0
BUDGET_APP_ID=0
VERIFIER_PUBLIC_KEY=
VERIFIER_PRIVATE_KEY=

# Services Ports
API_PORT=8000
VERIFIER_PORT=8001

# GoPlausible x402-avm Facilitator (Algorand TestNet)
# Public reference facilitator - no key needed to call /verify and /settle.
# See sentinelpay/payments/facilitator.py for the client and the risk note
# it resolves (facilitator supports atomic groups beyond the bare payment leg).
FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
