# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Model provider ────────────────────────────────────────────────────────────
# `local` (default) uses the deterministic rule-based planner: no model, fully
# reproducible, what the test suite runs.
# `ollama` lets a free local model plan the payment instead. Install Ollama and
# `ollama pull llama3.2:3b`. If it is not reachable the agent falls back to the
# rule-based planner with a warning; model choice is never part of the security
# argument.
MODEL_PROVIDER=local
MODEL_NAME=llama3.2:3b

# ── LangSmith / Managed Deep Agents (optional, free quota only) ────────────────
LANGSMITH_API_KEY=

# ── Algorand TestNet ──────────────────────────────────────────────────────────
ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=
INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
INDEXER_PORT=443
INDEXER_TOKEN=

# ── TestNet accounts — 25-word mnemonics. NEVER COMMIT THESE ──────────────────
# Generate: uv run python scripts/fund_testnet.py   (then fund at the dispenser)
# AGENT_MNEMONIC pays for the x402 payments and the group fees.
AGENT_MNEMONIC=
# Deploys the contract and may reset the spend counter. Falls back to
# AGENT_MNEMONIC if left blank; use a separate account for anything real.
CONTRACT_CREATOR_MNEMONIC=
VERIFIER_MNEMONIC=

# ── Deployed application IDs ──────────────────────────────────────────────────
# Set after: uv run python scripts/deploy_testnet.py
SENTINELPAY_APP_ID=0
# Set after: uv run python scripts/deploy_budget_app.py
BUDGET_APP_ID=0

# ── Verifier Ed25519 signing identity ─────────────────────────────────────────
# Generate both: uv run python scripts/gen_verifier_key.py
# The public key is baked into the contract at deploy time; the private key
# signs attestations and must never be committed or logged.
VERIFIER_PUBLIC_KEY=
VERIFIER_PRIVATE_KEY=

# ── x402 resource being sold ──────────────────────────────────────────────────
# Must be a real Algorand address for any on-chain flow. For a self-contained
# TestNet demo, reuse the AGENT_MNEMONIC account's address.
RESOURCE_OWNER_ADDRESS=
RESOURCE_PRICE_UALGO=100000

# ── Local service ports ───────────────────────────────────────────────────────
API_PORT=8000
VERIFIER_PORT=8001

# ── GoPlausible x402-avm facilitator (Algorand TestNet) ───────────────────────
# Public reference facilitator — no key needed for /verify and /settle.
FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
